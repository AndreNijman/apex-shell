# APEX Shell -> labwc theme. GENERATED by matugen; do not edit.
#
# Rendered from src/config/labwc-themerc.template on every wallpaper change,
# alongside the Hyprland border colours and the QML palette, so APEX Floating
# is themed from the same Material You source as the rest of the desktop rather
# than carrying a second, drifting palette.
#
# Hand-edited overrides belong in ~/.config/labwc/themerc, which labwc reads
# BEFORE this file... and therefore loses. Put persistent tweaks in
# ~/.config/labwc/themerc-override.local and source-control them yourself; this
# file is overwritten without warning.
#
# Geometry here is deliberate, not default:
#   titlebar padding 11 + an 11 pt Noto Sans face lands the titlebar in the
#   36-40 px band; buttons are 30x30 with a 15 px hover radius, which is what
#   makes the hover highlight a circle rather than a rounded oblong.

# ── borders ──────────────────────────────────────────────────────────────────
# 1 px. Thicker reads as a widget toolkit from 2009, and the shadow already
# does the work of separating a window from what is behind it.
border.width: 1
window.active.border.color: #{{colors.primary.default.hex_stripped}}
window.inactive.border.color: #{{colors.outline_variant.default.hex_stripped}}

# ── titlebar ─────────────────────────────────────────────────────────────────
window.active.title.bg.color: #{{colors.surface_container.default.hex_stripped}}
window.inactive.title.bg.color: #{{colors.surface.default.hex_stripped}}
window.active.label.text.color: #{{colors.on_surface.default.hex_stripped}}
window.inactive.label.text.color: #{{colors.on_surface_variant.default.hex_stripped}}
window.label.text.justify: center
window.titlebar.padding.height: 11
window.titlebar.padding.width: 10

# ── window buttons ───────────────────────────────────────────────────────────
window.button.width: 30
window.button.height: 30
window.button.spacing: 4
window.button.hover.bg.corner-radius: 15
window.active.button.unpressed.image.color: #{{colors.on_surface.default.hex_stripped}}
window.inactive.button.unpressed.image.color: #{{colors.on_surface_variant.default.hex_stripped}}
window.button.hover.bg.color: #{{colors.primary_container.default.hex_stripped}}

# ── shadows ──────────────────────────────────────────────────────────────────
# Active windows sit further off the surface than inactive ones; that
# difference is most of what makes focus readable without a loud border.
window.active.shadow.size: 36
window.inactive.shadow.size: 24
window.active.shadow.color: #{{colors.shadow.default.hex_stripped}}90
window.inactive.shadow.color: #{{colors.shadow.default.hex_stripped}}60

# ── menus ────────────────────────────────────────────────────────────────────
# The root menu is replaced by an APEX QML surface; this styles menu.xml, which
# remains as the emergency fallback when the shell is not running.
menu.border.width: 1
menu.border.color: #{{colors.outline_variant.default.hex_stripped}}
menu.items.bg.color: #{{colors.surface_container.default.hex_stripped}}
menu.items.text.color: #{{colors.on_surface.default.hex_stripped}}
menu.items.active.bg.color: #{{colors.primary_container.default.hex_stripped}}
menu.items.active.text.color: #{{colors.on_primary_container.default.hex_stripped}}
menu.items.padding.x: 12
menu.items.padding.y: 7
menu.title.bg.color: #{{colors.surface_container_high.default.hex_stripped}}
menu.title.text.color: #{{colors.on_surface.default.hex_stripped}}
menu.separator.color: #{{colors.outline_variant.default.hex_stripped}}
menu.separator.width: 1
menu.separator.padding.height: 6

# ── on-screen display / window switcher ──────────────────────────────────────
osd.bg.color: #{{colors.surface_container.default.hex_stripped}}
osd.border.color: #{{colors.outline_variant.default.hex_stripped}}
osd.border.width: 1
osd.label.text.color: #{{colors.on_surface.default.hex_stripped}}

# ── snapping overlays ────────────────────────────────────────────────────────
snapping.overlay.region.bg.enabled: yes
snapping.overlay.region.bg.color: #{{colors.primary.default.hex_stripped}}40
snapping.overlay.edge.bg.enabled: yes
snapping.overlay.edge.bg.color: #{{colors.primary.default.hex_stripped}}40
